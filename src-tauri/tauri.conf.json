{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finanse Desktop",
  "version": "0.1.0",
  "identifier": "com.finanse.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run sidecar && npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finanse Desktop",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Finance",
    "shortDescription": "Finan\u00e7as pessoais offline",
    "longDescription": "Finanse Desktop: lan\u00e7amentos, categorias, dashboard e backup local.",
    "externalBin": [
      "binaries/finanse-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "resources": {
      "../licenses/": "licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    },
    "license": "MIT"
  }
}
